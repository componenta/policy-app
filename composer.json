{
    "name": "componenta/policy-app",
    "description": "Deprecated compatibility provider for Componenta policy integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^3.0.0",
        "componenta/policy": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Policy\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Policy\\App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Policy\\App\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "prefer-stable": true
}
